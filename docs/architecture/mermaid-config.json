{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Cambria, \"Times New Roman\", serif",
    "fontSize": "20px",
    "primaryColor": "#ffffff",
    "primaryBorderColor": "#555555",
    "lineColor": "#222222",
    "textColor": "#1a1a1a",
    "clusterBkg": "#fbfbfb",
    "clusterBorder": "#9a9a9a",
    "edgeLabelBackground": "#ffffff"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "basis",
    "nodeSpacing": 8,
    "rankSpacing": 16,
    "padding": 5,
    "diagramPadding": 4,
    "wrappingWidth": 900,
    "subGraphTitleMargin": {
      "top": 2,
      "bottom": 12
    }
  },
  "themeCSS": ".nodeLabel, .edgeLabel, .nodeLabel p, .edgeLabel p, .cluster-label p, foreignObject div { line-height: 1.15 !important; }"
}